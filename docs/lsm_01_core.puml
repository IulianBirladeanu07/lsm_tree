@startuml lsm_01_core
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName monospace
skinparam defaultFontSize 12

skinparam rectangle {
  BackgroundColor white
  BorderColor #333333
  FontColor #333333
  BorderThickness 1.5
}

skinparam package {
  BackgroundColor #F8F8F8
  BorderColor #999999
  FontColor #555555
  BorderThickness 1
}

rectangle "**LSMTree**\nput() / get() / del() / scan()" as LSM

package "Write Buffer" {
  rectangle "WAL\n//append-only log//" as WAL
  rectangle "MemTable\n//ConcurrentSkipList//" as MEM
}

package "Disk Storage" {
  rectangle "LevelManager\n//L0 → L6//" as LM
  rectangle "SSTable\n//immutable sorted file//" as SST
  rectangle "BloomFilter\n//per SSTable//" as BF
  rectangle "BlockCache\n//LRU, 8MB//" as BC
}

package "Background" {
  rectangle "CompactionScheduler\n//Leveled | Tiered//" as CS
  rectangle "ThreadPool" as TP
}

LSM -down-> WAL : "1. append"
LSM -down-> MEM : "2. insert"
LSM -right-> LM : "get / scan"
MEM -right-> LM : "flush → L0"
LM -down-> SST
SST -right-> BF
SST -down-> BC
LSM -left-> CS : "schedule()"
CS -down-> TP

@enduml